[{"type":"cameraUpdate","width":800,"height":600,"x":-20,"y":-20},{"type":"text","id":"title","x":0,"y":0,"text":"Registration: how a new profile is made","fontSize":34,"strokeColor":"#1e1e1e"},{"type":"text","id":"sub","x":0,"y":48,"text":"gesture_capture.py (desktop), Register page (web / mobile)","fontSize":20,"strokeColor":"#495057"},{"type":"rectangle","id":"s0","x":180,"y":100,"width":540,"height":95,"backgroundColor":"#a5d8ff","fillStyle":"solid","strokeColor":"#1971c2","label":{"text":"1. Choose a username and a check level\nstandard = all checks\nrelaxed = kinematics left out of the decision","fontSize":18},"roundness":{"type":3}},{"type":"diamond","id":"dx","x":300,"y":225,"width":300,"height":150,"backgroundColor":"#fff3bf","fillStyle":"solid","strokeColor":"#f08c00","label":{"text":"Profile\nalready\nexists?","fontSize":18}},{"type":"rectangle","id":"own","x":820,"y":240,"width":500,"height":120,"backgroundColor":"#ffd8a8","fillStyle":"solid","strokeColor":"#e8590c","label":{"text":"Only the owner may replace it:\nneeds a granted sign-in in the\nlast 10 minutes, else refused","fontSize":18},"roundness":{"type":3}},{"type":"arrow","id":"a0","x":450.0,"y":195,"width":0.0,"height":30,"points":[[0.0,0],[0.0,30]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"s0","fixedPoint":[0.5,1]},"endBinding":{"elementId":"dx","fixedPoint":[0.5,0]}},{"type":"arrow","id":"a1","x":600,"y":300.0,"width":220,"height":0.0,"points":[[0,0.0],[220,0.0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"dx","fixedPoint":[1,0.5]},"endBinding":{"elementId":"own","fixedPoint":[0,0.5]},"label":{"text":"yes","fontSize":16}},{"type":"rectangle","id":"s1","x":180,"y":420,"width":540,"height":130,"backgroundColor":"#d0bfff","fillStyle":"solid","strokeColor":"#6741d9","label":{"text":"2. Face enrolment (optional)\n5 frames taken 0.35 s apart\nall must show the same person (cosine >= 0.50)\nskipped = gesture-only profile","fontSize":18},"roundness":{"type":3}},{"type":"arrow","id":"a2","x":450.0,"y":375,"width":0.0,"height":45,"points":[[0.0,0],[0.0,45]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"dx","fixedPoint":[0.5,1]},"endBinding":{"elementId":"s1","fixedPoint":[0.5,0]},"label":{"text":"no","fontSize":16}},{"type":"arrow","id":"a3","x":1070.0,"y":360,"width":350.0,"height":125,"points":[[0.0,0],[0.0,125],[-350.0,125.0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"own","fixedPoint":[0.5,1]},"endBinding":{"elementId":"s1","fixedPoint":[1,0.5]},"label":{"text":"owner confirmed","fontSize":16}},{"type":"cameraUpdate","width":800,"height":600,"x":-20,"y":380},{"type":"rectangle","id":"s2","x":180,"y":600,"width":540,"height":90,"backgroundColor":"#a5d8ff","fillStyle":"solid","strokeColor":"#1971c2","label":{"text":"3. Record one gesture sample: 3 s\n(starts when the user presses R)","fontSize":18},"roundness":{"type":3}},{"type":"rectangle","id":"few","x":820,"y":600,"width":500,"height":90,"backgroundColor":"#ffc9c9","fillStyle":"solid","strokeColor":"#e03131","label":{"text":"Fewer than 10 hand frames:\nrecording dropped, record again","fontSize":18},"roundness":{"type":3}},{"type":"arrow","id":"a4","x":450.0,"y":550,"width":0.0,"height":50,"points":[[0.0,0],[0.0,50]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"s1","fixedPoint":[0.5,1]},"endBinding":{"elementId":"s2","fixedPoint":[0.5,0]}},{"type":"arrow","id":"a5","x":720,"y":645.0,"width":100,"height":0.0,"points":[[0,0.0],[100,0.0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":"arrow","startBinding":{"elementId":"s2","fixedPoint":[1,0.5]},"endBinding":{"elementId":"few","fixedPoint":[0,0.5]}},{"type":"rectangle","id":"s3","x":180,"y":740,"width":540,"height":105,"backgroundColor":"#a5d8ff","fillStyle":"solid","strokeColor":"#1971c2","label":{"text":"4. Trim still frames at start and end\n(keep 3-97 % of the motion, >= 60 % of frames)\nresample to 60 frames, normalise the pose","fontSize":18},"roundness":{"type":3}},{"type":"arrow","id":"a6","x":450.0,"y":690,"width":0.0,"height":50,"points":[[0.0,0],[0.0,50]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"s2","fixedPoint":[0.5,1]},"endBinding":{"elementId":"s3","fixedPoint":[0.5,0]}},{"type":"diamond","id":"dq","x":260,"y":890,"width":380,"height":190,"backgroundColor":"#fff3bf","fillStyle":"solid","strokeColor":"#f08c00","label":{"text":"5. Quality gate\n(from the 3rd\nsample on)","fontSize":18}},{"type":"rectangle","id":"rej","x":820,"y":900,"width":500,"height":170,"backgroundColor":"#ffc9c9","fillStyle":"solid","strokeColor":"#e03131","label":{"text":"Too far from the accepted samples\n(mean DTW > 1.4 x their median):\nretry this sample (up to 3 times),\nthen record the whole set again\n(at most 2 restarts, then stop)","fontSize":18},"roundness":{"type":3}},{"type":"arrow","id":"a7","x":450.0,"y":845,"width":0.0,"height":45,"points":[[0.0,0],[0.0,45]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"s3","fixedPoint":[0.5,1]},"endBinding":{"elementId":"dq","fixedPoint":[0.5,0]}},{"type":"arrow","id":"a8","x":640,"y":985.0,"width":180,"height":0.0,"points":[[0,0.0],[180,0.0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"dq","fixedPoint":[1,0.5]},"endBinding":{"elementId":"rej","fixedPoint":[0,0.5]},"label":{"text":"outlier","fontSize":16}},{"type":"cameraUpdate","width":800,"height":600,"x":-20,"y":780},{"type":"diamond","id":"d5","x":290,"y":1120,"width":320,"height":150,"backgroundColor":"#fff3bf","fillStyle":"solid","strokeColor":"#f08c00","label":{"text":"5 samples\naccepted?","fontSize":18}},{"type":"arrow","id":"a9","x":450.0,"y":1080,"width":0.0,"height":40,"points":[[0.0,0],[0.0,40]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"dq","fixedPoint":[0.5,1]},"endBinding":{"elementId":"d5","fixedPoint":[0.5,0]},"label":{"text":"accepted","fontSize":16}},{"type":"arrow","id":"a10","x":290,"y":1195.0,"width":190,"height":550.0,"points":[[0,0.0],[-190,0.0],[-190,-550.0],[-110,-550.0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"d5","fixedPoint":[0,0.5]},"endBinding":{"elementId":"s2","fixedPoint":[0,0.5]},"label":{"text":"no: next sample","fontSize":16}},{"type":"rectangle","id":"s4","x":180,"y":1310,"width":540,"height":190,"backgroundColor":"#b2f2bb","fillStyle":"solid","strokeColor":"#2f9e44","label":{"text":"6. Calibrate this user's thresholds\nDTW: the larger of median + 2.5 x 1.4826 x MAD\nand 90th percentile x 1.15; capped at\nmax x 1.25; never below 2.0\nalso: finger-state, transition, segment gates,\nwrist path (never below 3.0),\nhand-shape ratios, kinematic profile","fontSize":18},"roundness":{"type":3}},{"type":"arrow","id":"a11","x":450.0,"y":1270,"width":0.0,"height":40,"points":[[0.0,0],[0.0,40]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"d5","fixedPoint":[0.5,1]},"endBinding":{"elementId":"s4","fixedPoint":[0.5,0]},"label":{"text":"yes","fontSize":16}},{"type":"cameraUpdate","width":800,"height":600,"x":-20,"y":1180},{"type":"rectangle","id":"s5","x":180,"y":1540,"width":540,"height":105,"backgroundColor":"#ffd8a8","fillStyle":"solid","strokeColor":"#e8590c","label":{"text":"7. Uniqueness check vs the cohort library\nwarning if a common gesture comes closer\nthan 1.5 x the user's own spread","fontSize":18},"roundness":{"type":3}},{"type":"rectangle","id":"s6","x":180,"y":1690,"width":540,"height":110,"backgroundColor":"#b2f2bb","fillStyle":"solid","strokeColor":"#2f9e44","label":{"text":"8. Save the profile in one step (atomic)\ntemplates/<user>/ (diagram 06)\nincl. trim method and check level","fontSize":18},"roundness":{"type":3}},{"type":"rectangle","id":"n6","x":820,"y":1540,"width":500,"height":105,"backgroundColor":"#fff3bf","fillStyle":"solid","strokeColor":"#f08c00","label":{"text":"The warning does not block saving:\nthe user decides whether to keep\nthe gesture","fontSize":18},"roundness":{"type":3},"strokeStyle":"dashed"},{"type":"arrow","id":"a12","x":450.0,"y":1500,"width":0.0,"height":40,"points":[[0.0,0],[0.0,40]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"s4","fixedPoint":[0.5,1]},"endBinding":{"elementId":"s5","fixedPoint":[0.5,0]}},{"type":"arrow","id":"a13","x":450.0,"y":1645,"width":0.0,"height":45,"points":[[0.0,0],[0.0,45]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startBinding":{"elementId":"s5","fixedPoint":[0.5,1]},"endBinding":{"elementId":"s6","fixedPoint":[0.5,0]}},{"type":"arrow","id":"a14","x":820,"y":1592.5,"width":100,"height":0.0,"points":[[0,0.0],[-100,0.0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","strokeStyle":"dashed","startBinding":{"elementId":"n6","fixedPoint":[0,0.5]},"endBinding":{"elementId":"s5","fixedPoint":[1,0.5]}},{"type":"cameraUpdate","width":2400,"height":1800,"x":-60,"y":-40}]